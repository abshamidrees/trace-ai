# ─────────────────────────────────────────────────────────────────────────────
# Trace AI — Environment Variables
# Copy this file to .env and fill in your keys.
# The tool works in demo mode without any keys — add them for live blockchain data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Blockchain APIs (all free tier) ──────────────────────────────────────────

# Etherscan — EVM chains (Ethereum, Base, Arbitrum, Optimism)
# Get your key at: https://etherscan.io/apis
ETHERSCAN_API_KEY=I1F2FUBNVPRASWWYPVNY3JIDD38IKEUNQF

# Helius — Solana transactions
# Get your key at: https://helius.dev
HELIUS_API_KEY=8e1cb698-aebb-4a29-afdc-217e70fe8d71

# ── OpenGradient — TEE-verified AI ───────────────────────────────────────────

# Your OpenGradient wallet private key
# Create a wallet at: https://hub.opengradient.ai
OG_PRIVATE_KEY=0xa1fcd159eb98f123d842ec3319289dc1618c2b98ea3f3dc3899caa47347b7d45

# Deployed workflow contract address
# Run: python deploy_workflow.py   to get this
OG_WORKFLOW_ADDRESS=

# OpenGradient RPC endpoint (leave as-is for testnet)
OG_RPC_URL=https://rpc.opengradient.ai

# ── Frontend ──────────────────────────────────────────────────────────────────

# Backend URL — change this when deploying to production
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
